# The runtime aliases @deepseek-ai/* host packages for a mounted plugin row, so
# they are deliberately not dependencies. `npm run test:mount` needs one of them
# resolvable locally; link the deployment's copy rather than installing a second
# one, which would be a different module instance than the running host's.
node_modules/

# Scratch output from a live run.
.dsh-xcodebuild/
*.log

# A workspace-local browser-automation toolchain, used to drive the DSH GUI and
# check that the panel actually renders. Never part of the plugin.
.tools/

# Local scratch: previews, release-note drafts, session archives, and the npm
# credentials file used to publish. Ignored by the repository rather than by a
# local exclude, so a publish token cannot be committed by anyone, on any clone.
.analysis/
